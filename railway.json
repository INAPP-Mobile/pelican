{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "/usr/local/bin/docker-entrypoint.sh /bin/ash /entrypoint.sh supervisord -n -c /etc/supervisord.conf",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "volumes": {
    "pelican-data": {
      "mountPath": "/pelican-data",
      "size": 10
    }
  }
}
