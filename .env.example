# Required: Public URL for the panel
# Railway auto-generates this — leave as ${{RAILWAY_PUBLIC_DOMAIN}} in template-vars.json
APP_URL=http://localhost

# Required: Let's Encrypt email (only needed if APP_URL is https://)
LE_EMAIL=

# Application Environment
APP_ENV=production
APP_DEBUG=false
APP_INSTALLED=false
APP_LOCALE=en

# Database (SQLite by default — stored in /pelican-data)
DB_CONNECTION=sqlite
# For external MySQL/PostgreSQL, uncomment and set:
# DB_CONNECTION=mysql
# DB_HOST=
# DB_PORT=3306
# DB_DATABASE=pelican
# DB_USERNAME=pelican
# DB_PASSWORD=

# Cache Driver (file, redis, memcached)
CACHE_DRIVER=file

# Session Driver (file, redis, cookie, database)
SESSION_DRIVER=file

# Queue Driver (database, redis, sync)
QUEUE_DRIVER=database

# Mail (log = no mail sent)
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM=noreply@example.com
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls

# Trusted Proxies (comma-separated IPs)
TRUSTED_PROXIES=

# Behind Proxy (set true if behind Cloudflare/reverse proxy)
BEHIND_PROXY=false

# Skip Caddy (enable for PHP-FPM only)
SKIP_CADDY=false
